      2 ≤ N ∧
        ∀ (V : Finset ℕ),
          (∀ v ∈ V, 0 < v) →
            N ≤ V.card →
              ∃ t ∈ Set.Ico 0 1,
                ∀ v ∈ V, ∀ (k : ℤ), 1 / (2 * ↑V.card) + 1 / (2 * ↑V.card ^ (3 / 2 + κ)) ≤ |↑v * t - ↑k| :=

theorem LonelyRunner.mainTheorem : ∀ (κ : ℝ),
  0 < κ →
    ∃ N,
      2 ≤ N ∧
        ∀ (V : Finset ℕ),
          (∀ v ∈ V, 0 < v) →
            N ≤ V.card → ∃ t, ∀ v ∈ V, 1 / (2 * ↑V.card) + 1 / (2 * ↑V.card ^ (3 / 2 + κ)) ≤ dist (v • t) 0 :=
⋯
theorem LonelyRunner.mainTheorem_real : ∀ (κ : ℝ),

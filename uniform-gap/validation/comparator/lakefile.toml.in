name = "LonelyRunnerAcceptance"
version = "1.0.0"
defaultTargets = ["Challenge", "Solution"]

[leanOptions]
relaxedAutoImplicit = false

[[require]]
name = "mathlib"
scope = "leanprover-community"
rev = "v4.34.1"

[[lean_lib]]
name = "Challenge"

[[lean_lib]]
name = "Solution"

[[lean_lib]]
name = "LonelyRunnerNew"

[[lean_lib]]
name = "LonelyRunnerSpec"
